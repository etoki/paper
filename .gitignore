# PDFs (large, stored elsewhere)
*.pdf
# ...except under simulation/data/
!simulation/data/**/*.pdf
# ...and pre-registration PDFs (small, OSF supplementary uploads)
!simulation/docs/pre_registration/*.pdf
# ...and journal-specific anonymised submission PDFs (small, submission-ready)
!metaanalysis/paper_v2/*_anon.pdf

# Claude Code local settings
.claude/

# OS / editor
.DS_Store
Thumbs.db
*.swp
*~

# Python
__pycache__/
*.pyc
.venv/
venv/

# Stage 0 pipeline outputs (regenerable via `make reproduce`)
simulation/output/supplementary/
simulation/output/tables/
simulation/output/figures/

# Secrets / API keys (never commit)
.env
.env.*
!.env.example
.coverage

# Local docx backups created by apply_hallucination_fixes.py
*.docx.bak

# sr_update: raw API responses (zipped to OSF instead) and full-text PDFs
# (copyrighted; kept locally only)
metaanalysis/sr_update/raw/
metaanalysis/sr_update/fulltext/pdf/*
!metaanalysis/sr_update/fulltext/pdf/.gitkeep
metaanalysis/sr_update/.openalex_key
